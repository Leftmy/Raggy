# ===============================
# Application & Server Settings
# ===============================
APP_ENV=development
DEBUG=False
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
API_AUTH_TOKEN=
MAX_UPLOAD_SIZE_BYTES=20971520
API_RATE_LIMIT_PER_HOUR=60
BOT_RATE_LIMIT_PER_HOUR=60
RATE_LIMIT_WINDOW_SECONDS=3600

# ===============================
# Telegram Bot Configuration
# ===============================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=[]

# ===============================
# LLM Provider Configuration
# ===============================
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=60
LLM_SYSTEM_PROMPT=

# ===============================
# Vector Store Configuration
# ===============================
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_HOST=vector_db
VECTOR_STORE_PORT=6333
VECTOR_STORE_GRPC_PORT=6334
VECTOR_STORE_COLLECTION=rag_documents
VECTOR_STORE_API_KEY=

# ===============================
# Embedding & Rerank Configuration
# ===============================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# ===============================
# Chunking & Retrieval Strategy
# ===============================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PARENT_CHUNK_SIZE=2000
MAX_CHUNKS_PER_DOCUMENT=10000
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
