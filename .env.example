# ===============================
# Application & Server Settings
# ===============================
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000

# ===============================
# Telegram Bot Configuration
# ===============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===============================
# LLM Provider Configuration
# ===============================
LLM_PROVIDER=gemini
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-1.5-pro

# ===============================
# Vector Store Configuration
# ===============================
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_HOST=vector_db
VECTOR_STORE_PORT=6333
VECTOR_STORE_GRPC_PORT=6334
VECTOR_STORE_COLLECTION=rag_documents
VECTOR_STORE_API_KEY=

# ===============================
# Embedding & Rerank Configuration
# ===============================
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2

# ===============================
# Chunking & Retrieval Strategy
# ===============================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=10
TOP_K_RERANK=3
